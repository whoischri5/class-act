# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored, so your secrets never reach GitHub.

# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# Leave blank to use a local SQLite file (backend/data/ucl.db).
# For Supabase, paste the *Session pooler* connection string as-is (see DEPLOY.md), e.g.
# DATABASE_URL=postgresql://postgres.abcd1234:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Champions League + Europe's top 5 leagues (the leagues only feed Elo/form).
COMPETITIONS=CL,PL,PD,BL1,SA,FL1

# Frontend URLs allowed to call the API (on Render this is set for you in render.yaml).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
